generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SpreadPoint {
  id        String   @id @default(cuid())
  timestamp DateTime @unique
  value     Float

  @@index([timestamp])
}

enum AlertCondition {
  above
  below
}

enum AlertKind {
  PRICE
  RULO
}

enum VirtualTxType {
  BUY
  SELL
  DEPOSIT
}

model User {
  id        String              @id @default(cuid())
  email     String              @unique
  password  String?
  name      String?
  googleId  String?             @unique
  avatarUrl String?
  telegramId String?            @unique // ID on Telegram for the Bot
  twoFactorSecret String?       // 2FA TOTP Secret Key
  twoFactorEnabled Boolean      @default(false)
  tokenVersion Int              @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  alerts    Alert[]
  portfolio PortfolioPosition[]
  balances  VirtualBalance[]
  virtualTxs VirtualTransaction[]
  apiKeys   ExchangeKey[]
  pushSubs  PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Alert {
  id        String   @id @default(cuid())
  kind      AlertKind @default(PRICE)
  routeId   String?
  capital   Decimal? @db.Decimal(20, 8)
  lastTriggeredAt DateTime?
  asset     String   // "blue" | "mep" | "ccl" | "crypto"
  condition AlertCondition
  threshold Decimal @db.Decimal(20, 8)
  active    Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([active, userId])
}

model RuloSnapshot {
  id        String   @id @default(cuid())
  timestamp DateTime
  routeId   String
  grossPct  Float
  netPct    Float

  @@unique([routeId, timestamp])
  @@index([routeId, timestamp])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  path        String?
  props       Json?
  sessionHash String
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
}

model PortfolioPosition {
  id        String   @id @default(cuid())
  asset     String
  buyPrice  Decimal  @db.Decimal(20, 8)
  amount    Decimal  @db.Decimal(20, 8)
  date      DateTime @db.Date
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model VirtualBalance {
  id              String   @id @default(cuid())
  currency        String   // "ARS" | "USD" | "USDT" | "BTC"
  amount          Decimal  @default(0) @db.Decimal(20, 8)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
}

model VirtualTransaction {
  id              String   @id @default(cuid())
  type            VirtualTxType
  asset           String   // "MEP" | "BLUE" | "CRYPTO"
  amount          Decimal  @db.Decimal(20, 8)
  price           Decimal  @db.Decimal(20, 8)
  totalArs        Decimal  @db.Decimal(20, 8)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model ExchangeKey {
  id              String   @id @default(cuid())
  exchange        String   // "BINANCE" | "LEMON" | "BUENBIT"
  apiKey          String
  apiSecret       String   // Stored optionally/encrypted depending on exchange
  passthrough     String?  // Optional extra parameters (passphrases)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, exchange])
  @@index([userId])
}
