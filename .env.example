# Variables de entorno para Rulos Locos

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# Tiempo de caché en milisegundos (opcional, por defecto 30000 = 30 segundos)
CACHE_TTL=30000

# Timeout para peticiones a APIs externas en milisegundos (opcional, por defecto 10000 = 10 segundos)
API_TIMEOUT=10000

# Modo de desarrollo (opcional, valores: development|production)
NODE_ENV=development

# Habilitar logs detallados (opcional, valores: true|false)
VERBOSE_LOGGING=false

# URL del cliente (para CORS en producción)
CLIENT_URL=http://localhost:5173

# API Keys
# BCRA_TOKEN=tu_token_bcra_aqui
# ARGENSTATS_KEY=tu_key_argenstats_aqui
# NEWS_API_KEY=

# Clave de Gemini para el Analista Macroeconómico IA (Opcional)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_key_newsdata_aqui

# Telegram Notifications (opcional)
# TELEGRAM_BOT_TOKEN=tu_bot_token_aqui     # se obtiene creando bot en @BotFather
# TELEGRAM_CHAT_ID=tu_chat_id_aqui         # primero hablá con tu bot y obtené el chat_id

# Auth JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro_min_32_chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruloslocos?schema=public

# Google OAuth (frontend + backend)
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Email Notifications (opcional — SMTP)
# EMAIL_USER=tu@gmail.com
# EMAIL_PASS=contraseña_de_aplicacion
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_RECIPIENT=destino@gmail.com  # a quién se envían las alertas de precio

# Binance API (opcional, para futuras integraciones)
# BINANCE_API_KEY=your_binance_key_here
# BINANCE_SECRET_KEY=your_binance_secret_here
